# Settings for docker/compose.yaml. Copy to .env next to it and fill it in.
# The same names work in the Agentry API's .env, so one key serves both sides.

# Required. Postgres password for the bundled database (agentry_sandbox).
POSTGRES_PASSWORD=

# Required. The key the Agentry API sends (AGENTRY_SANDBOX_KEY there). Only its SHA-256 hash is used here.
# Make one with: openssl rand -hex 32
AGENTRY_SANDBOX_KEY=

# Required, at least 32 bytes. Each sandbox's envd token is derived from it: keep it stable, keep it secret.
# Make one with: openssl rand -base64 48
AGENTRY_SANDBOX_SECRET=

# Optional: turns on http://<host>:3090/admin (must differ from the key above).
# AGENTRY_SANDBOX_ADMIN_KEY=

# Optional: image tag (default latest), port, bind address, host port of the bundled Postgres.
# AGENTRY_SANDBOX_TAG=latest
# AGENTRY_SANDBOX_PORT=3090
# AGENTRY_SANDBOX_HOST=0.0.0.0
# AGENTRY_SANDBOX_DB_PORT=55433

# Optional: limits and defaults (see the README for the full list).
# AGENTRY_SANDBOX_MAX_PER_OWNER=5
# AGENTRY_SANDBOX_MAX_RUNNING_PER_OWNER=2
# AGENTRY_SANDBOX_IDLE_MINUTES=30
# AGENTRY_SANDBOX_CPUS=2
# AGENTRY_SANDBOX_MEMORY_MB=4096
# AGENTRY_SANDBOX_RUNTIME=runc
# AGENTRY_SANDBOX_EGRESS=on
