{
  "name": "@agentry/sandbox",
  "version": "0.1.0",
  "private": true,
  "description": "Agentry Sandbox: hardened Docker sandboxes on demand, each running E2B's envd, behind an authenticated relay.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "gen": "buf generate third_party/envd/spec",
    "images:build": "bash scripts/images-build.sh"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.17.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-node": "2.3.0",
    "dockerode": "4.0.12",
    "pg": "8.23.1",
    "tar-stream": "3.3.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.75.0",
    "@bufbuild/protoc-gen-es": "2.17.0",
    "@types/dockerode": "4.0.2",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/tar-stream": "3.1.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "exports": {
    "./client": "./src/client/index.ts",
    "./testing": "./src/testing.ts",
    "./package.json": "./package.json"
  }
}
